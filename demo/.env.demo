# =============================================================================
# Backend condiviso per la demo (ozon-env-app + db + keycloak + companion).
# Uso: docker compose -p ozon-demo -f backend/docker-compose.yml \
#        -f demo/docker-compose.demo.yml --env-file demo/.env.demo up -d
# =============================================================================

BACKEND_DOCKER_NETWORK=ozon-network

# --- ozon-env-app (backend) ---
APP_CODE=demo
OZON_APP_NAME=ozon-env-app-demo
LOG_LEVEL=info
ASGI_HOST=0.0.0.0
ASGI_PORT=8000
AUTH_MODE=keycloak
OZON_LOCALEDIR=/app/i18n
OZON_APPLANG=it

MONGO_USER=demo
MONGO_PASS=23bebb2b83b9d5c37d72e940
MONGO_URL=ozon-env-app-db:27017
MONGO_DB=demo

SESSION_SECRET=9fc743929ac0f9c0bd400a2bda5cdd0d4e90b70a6791e92f5db93dfde645f86b
COOKIE_SECURE=false

OZON_APP_PORT=7999

# URL pubblico usato per costruire il redirect_uri OAuth2 (deve combaciare
# col client Keycloak) — qui punta al web-client (nginx proxya /auth/ /login
# /logout /refresh al backend), cosi' browser e cookie restano single-origin.
EXTERNAL_BASE_URL=http://localhost:4200

# --- Keycloak (incluso nello stack, container "keycloak") ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=b6a7e4b1356323d5
KEYCLOAK_PORT=8081
KEYCLOAK_SERVER_URL_INTERNAL=http://keycloak:8080
KEYCLOAK_SERVER_URL_PUBLIC=http://localhost:8081
KEYCLOAK_REALM=backend
KEYCLOAK_CLIENT_ID=backend-web
# valorizzato da demo/provision_keycloak.sh dopo la creazione del client
KEYCLOAK_CLIENT_SECRET=nxDpVjpxwn1s9XoNCnVeD6gbFzhmfeRt
OZON_TOKEN_AUDIENCE=demo
SCHEDULER_OAUTH_AUDIENCE=demo
TOKEN_AUDIENCE=demo

# --- calendar-scheduler (M2M: client_credentials verso l'app) ---
# SCHEDULER_OAUTH_CLIENT_SECRET valorizzato da demo/provision_keycloak.sh.
# OZON_TOKEN_AUDIENCE non e' impostato sul backend -> verify_aud disattivato,
# quindi qui audience/scope restano vuoti (nessun mapper richiesto).
SCHEDULER_RUN_BASE_URL=http://ozon-env-app:8000
SCHEDULER_OAUTH_TOKEN_URL=http://keycloak:8080/realms/backend/protocol/openid-connect/token
SCHEDULER_OAUTH_CLIENT_ID=calendar-scheduler
SCHEDULER_OAUTH_CLIENT_SECRET=BUvYt6IASE73t3DrZLWW9ZHXA0KSR0TO

# --- Immagini: nessun override qui, si usano i default di backend/docker-compose.yml
# (ghcr.io/inrim/ozon-env-app/*, pubbliche).
