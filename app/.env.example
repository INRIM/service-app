# =============================================================================
# Frontend per ogni singolo client. Copia in .env.client-<nome>, un file per client,
# stesso backend condiviso (vedi ../backend/docker-compose.yml).
# Uso: docker compose -p ozon-client-<nome> -f docker-compose.client.example.yml --env-file .env.client-<nome> up -d
# =============================================================================

# Nome container univoco sull'host Docker — obbligatorio.
OZON_APP_WEB_CONTAINER_NAME=

# app_code di questo client sul backend condiviso — obbligatorio.
APP_CODE=

# Rete del backend a cui agganciarsi — deve combaciare col BACKEND_DOCKER_NETWORK
# usato nel .env del backend condiviso.
BACKEND_DOCKER_NETWORK=ozon-network
# URL interno: il nome host deve combaciare con OZON_ENV_APP_CONTAINER_NAME
# configurato nel .env del backend.
BACKEND_UPSTREAM=http://ozon-env-app:8000

# Porta esposta sull'host per questo client (una diversa per ciascuno).
OZON_ANGULAR_PORT=4200

# URL backend raggiungibile dal browser (host, non dal container).
BACKENDURL=http://app:7999
SITE_URL=

AUTH_LOGIN_PATH=/api/login
AUTH_LOGOUT_PATH=/api/logout
AUTH_REFRESH_PATH=/api/auth/refresh
APP_MODULE_NAME=

# --- Immagine (default: ghcr.io/inrim/ozon-formio, vedi
# https://github.com/orgs/INRIM/packages?repo_name=ozon-env-app — pacchetto
# pubblico, scaricabile senza autenticazione. Override qui solo per pinnare
# una versione o usare un'immagine buildata in locale) ---
# OZON_APP_WEB_IMAGE=ghcr.io/inrim/ozon-formio:latest
