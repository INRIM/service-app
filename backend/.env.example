# =============================================================================
# Nuovo progetto: BACKEND condiviso (ozon-env-app + db + companion).
# Copia in .env, adatta i valori. Vedi docker-compose.yml in questa cartella.
# Il frontend (ozon-app-web) NON sta qui: e' multi-tenant, un'istanza per
# client/app_code — vedi docker-compose.client.example.yml + .env.client.example.
# =============================================================================

# --- Rete condivisa (deve combaciare col client compose) ---
BACKEND_DOCKER_NETWORK=ozon-network

# --- ozon-env-app (backend) ---
# Fallback quando la request non specifica app_code (query param o cookie) —
# NON e' "l'unico" app_code: il backend e' multi-tenant, ogni client lo
# seleziona per request. Vedi APP_CODE nel .env del client.
APP_CODE=
OZON_APP_NAME=ozon-env-app
LOG_LEVEL=info
ASGI_HOST=0.0.0.0
ASGI_PORT=8000
AUTH_MODE=keycloak

MONGO_USER=
MONGO_PASS=
MONGO_URL=ozon-env-app-db:27017
MONGO_DB=

SESSION_SECRET=change-me
COOKIE_SECURE=false

OZON_APP_PORT=7999

# --- Keycloak (incluso nello stack, container "keycloak") ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8081
# Interno: l'app chiama keycloak sulla rete docker. Pubblico: quello che il
# browser/keycloak-manager usa da fuori (localhost:KEYCLOAK_PORT in locale).
KEYCLOAK_SERVER_URL_INTERNAL=http://keycloak:8080
KEYCLOAK_SERVER_URL_PUBLIC=http://localhost:8081
KEYCLOAK_REALM=backend
KEYCLOAK_CLIENT_ID=backend-web
KEYCLOAK_CLIENT_SECRET=change-me
# Se valorizzato, il backend accetta soltanto token con questo valore in aud.
OZON_TOKEN_AUDIENCE=
# Realm/client su questo keycloak non esistono di default: vanno creati
# (console admin, o manager/keycloak-manager puntato su KEYCLOAK_SERVER_URL_PUBLIC).

# --- Immagini (default: ghcr.io/inrim/ozon-env-app/*, vedi
# https://github.com/orgs/INRIM/packages?repo_name=ozon-env-app — pacchetti
# pubblici, scaricabili senza autenticazione. Override qui solo se vuoi
# pinnare una versione invece di :latest, o usare un'immagine buildata in
# locale) ---
# OZON_ENV_APP_IMAGE=ghcr.io/inrim/ozon-env-app:latest
# OZON_ENV_APP_DB_IMAGE=ghcr.io/inrim/ozon-env-app/db:latest
# OZON_MAIL_SENDER_IMAGE=ghcr.io/inrim/ozon-env-app/mail-sender:latest
# OZON_CALENDAR_SCHEDULER_IMAGE=ghcr.io/inrim/ozon-env-app/calendar-scheduler:latest
# OZON_IDENTITY_MANAGER_IMAGE=ghcr.io/inrim/ozon-env-app/identity-manager:latest
