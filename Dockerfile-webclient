FROM python:3.12-slim

LABEL maintainer="Alessio Gerace <a.gerace@inrim.it>"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

ARG TZ
ARG REQUIREMENTS
ENV REQUIREMENTS_SCRIPT=${REQUIREMENTS}

# --- Base setup & timezone ---
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends tzdata && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# --- System dependencies ---
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential python3-dev git wget curl \
        libldap2-dev libsasl2-dev \
        fontconfig libxrender1 xfonts-base xfonts-75dpi \
        libjpeg62-turbo libxext6 libssl3 \
        locales gcc g++ && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Install wkhtmltopdf (bookworm-compatible build) ---
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    wget https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bookworm_$(dpkg --print-architecture).deb && \
    apt-get install -y ./wkhtmltox_0.12.6.1-3.bookworm_$(dpkg --print-architecture).deb && \
    rm wkhtmltox_0.12.6.1-3.bookworm_$(dpkg --print-architecture).deb && \
    rm -rf /var/lib/apt/lists/*

RUN wkhtmltopdf --version

# --- Locale ---
ENV LC_ALL=it_IT.UTF-8 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8

# --- App setup ---
COPY ./start.sh /start.sh
COPY ./gunicorn_conf.py /gunicorn_conf.py
COPY . /apps

RUN /apps/$REQUIREMENTS_SCRIPT 'web-client'

ENV PYTHONPATH=/app
WORKDIR /app

ENTRYPOINT ["/start.sh"]